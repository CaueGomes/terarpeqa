{
  "version": "0.2.0",
  "configurations": [
    {
      // Breakpoints no Express, nas rotas e nas consultas ao banco.
      // O Postgres sobe junto, dentro deste mesmo processo.
      "name": "API (servidor)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/index.js",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "restart": true,
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    },
    {
      // Sobe o Vite e, quando ele anuncia a URL, abre o Chrome já anexado ao
      // depurador. Breakpoints em src/App.jsx param no código-fonte.
      // NO_COLOR mantém a saída limpa para o padrão abaixo casar.
      "name": "Front (navegador)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "internalConsole",
      "env": { "NO_COLOR": "1" },
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}"
      },
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Tudo (API + front)",
      "configurations": ["API (servidor)", "Front (navegador)"],
      "stopAll": true
    }
  ]
}
