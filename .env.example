# Copie para .env e preencha. NUNCA comite o .env de verdade.

# String de conexão do Postgres (Render, Neon, Supabase...).
# No Render, use a "Internal Database URL" do seu banco.
DATABASE_URL=postgresql://usuario:senha@host:5432/terarpeqa

# Segredo que assina o cookie de sessão. Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-longo
