# Copie para .env e ajuste. NUNCA comite o .env de verdade.

# Desenvolvimento: "pglite:<pasta>" sobe um Postgres dentro do próprio processo
# da API e grava os dados na pasta indicada. Não exige instalar nada.
DATABASE_URL=pglite:./.pgdata

# Produção: use a string de conexão do Postgres de verdade. No Render, a
# "Internal Database URL" do banco. Exemplo:
# DATABASE_URL=postgresql://usuario:senha@host:5432/terarpeqa

# Segredo que assina o cookie de sessão. Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

PORT=3001
